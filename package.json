{
  "name": "sentinel-ai",
  "version": "1.0.0",
  "description": "Predictive DevOps & Deployment Guardian for Slack",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build-frontend && tsc",
    "build-frontend": "npm --prefix frontend install && npm --prefix frontend run build",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts"
  },
  "dependencies": {
    "@slack/bolt": "^4.7.3",
    "axios": "^1.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^9.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
